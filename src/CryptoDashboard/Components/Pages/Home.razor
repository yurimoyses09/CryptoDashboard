@page "/"
@inject DashboardQueries Queries
@inject IDailySummaryService Summary
@inject IOptions<CoinSettings> Settings

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Atualizando..." : "Atualizar")
    </button>
</div>

<div class="row row-cards mb-4">
    @foreach (var k in _coins.Take(4))
    {
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">@k.Name · @k.Symbol.ToUpperInvariant()</div>
                    <div class="h2 mb-1">@(k.Price is null ? "—" : "US$ " + Format.Price(k.Price))</div>
                    <div class="@Format.VariationClass(k.Variation24h)">
                        @Format.Pct(k.Variation24h) <span class="text-muted small">24h</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<DailySummaryCard Items="_summary" Coins="_coins" />

<CoinTable Rows="_coins" />

<section class="card mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h2 class="h5 mb-0">Comparativo de preço</h2>
            <div class="btn-group btn-group-sm" role="group" aria-label="Período">
                <button type="button" class="btn @RangeClass(1)" @onclick="() => SetRangeAsync(1)">24h</button>
                <button type="button" class="btn @RangeClass(7)" @onclick="() => SetRangeAsync(7)">7 dias</button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 mb-3">
            @foreach (var c in _coins)
            {
                <label class="form-check mb-0">
                    <input class="form-check-input" type="checkbox"
                           checked="@_selected.Contains(c.CoinId)"
                           @onchange="e => ToggleCoinAsync(c.CoinId, e)" />
                    <span class="form-check-label">@c.Symbol.ToUpperInvariant()</span>
                </label>
            }
        </div>

        <PriceChart Points="_history" CoinIds="_selected" />

        <p class="small text-muted mt-2 mb-0">
            A variação é medida desde o primeiro ponto do período, para comparar moedas com preços muito diferentes.
        </p>
    </div>
</section>

<NewsList News="_news" Coins="_coins" SelectedCoin="_newsCoin" OnFilterChanged="FilterNewsAsync" />

@code {
    private IReadOnlyList<CoinRow> _coins = [];
    private IReadOnlyList<CoinDailySummary> _summary = [];
    private IReadOnlyList<PricePointDto> _history = [];
    private IReadOnlyList<NewsRow> _news = [];
    private List<string> _selected = [];
    private string? _newsCoin;
    private int _rangeDays = 1;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        // Seleção inicial: três moedas para o gráfico não ficar poluído
        _selected = Settings.Value.Coins
            .Where(c => c is "bitcoin" or "ethereum" or "solana")
            .ToList();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _coins = await Queries.GetCoinTableAsync(Settings.Value.Coins);
            _summary = await Summary.GetAsync(TimeSpan.FromHours(24), 10);
            _news = await Queries.GetNewsAsync(_newsCoin);
            await LoadHistoryAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        _history = await Queries.GetHistoryAsync(_selected, TimeSpan.FromDays(_rangeDays));
    }

    private async Task ToggleCoinAsync(string coinId, ChangeEventArgs e)
    {
        var selected = e.Value is true;

        if (selected && !_selected.Contains(coinId))
            _selected.Add(coinId);
        else if (!selected)
            _selected.Remove(coinId);

        await LoadHistoryAsync();
    }

    private async Task SetRangeAsync(int days)
    {
        _rangeDays = days;
        await LoadHistoryAsync();
    }

    private async Task FilterNewsAsync(string? coinId)
    {
        _newsCoin = coinId;
        _news = await Queries.GetNewsAsync(coinId);
    }

    private string RangeClass(int days) => days == _rangeDays ? "btn-primary" : "btn-outline-primary";
}
