<div class="card mb-4">
    <div class="card-header">
        <h2 class="card-title">Moedas</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Moeda</th>
                    <th class="text-end">Preço (USD)</th>
                    <th class="text-end">Var. 24h</th>
                    <th class="text-end">Capitalização</th>
                    <th>Sentimento 24h</th>
                    <th class="text-end">Notícias</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Rows)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@r.Symbol.ToUpperInvariant()</div>
                            <div class="text-muted small">@r.Name</div>
                        </td>
                        <td class="text-end">@Format.Price(r.Price)</td>
                        <td class="text-end @Format.VariationClass(r.Variation24h)">@Format.Pct(r.Variation24h)</td>
                        <td class="text-end">@Format.MarketCap(r.MarketCap)</td>
                        <td><SentimentBadge Label="@SentimentLabel.FromScore(r.AverageScore24h)" /></td>
                        <td class="text-end">@r.NewsCount24h</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<CoinRow> Rows { get; set; } = [];
}
