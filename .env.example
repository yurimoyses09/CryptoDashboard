# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ser enviado para o Git.

# Modelo do Ollama. Precisa estar baixado no container:
#   docker compose exec ollama ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Timeout de cada chamada ao modelo, em minutos (CPU pode ser lenta)
OLLAMA_TIMEOUT_MINUTES=10
