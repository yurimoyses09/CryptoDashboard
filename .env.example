# Copie este arquivo para .env e preencha os valores.
# O .env está no .gitignore e nunca deve ser enviado para o Git.

# Provedor de sentimento: Ollama (local) ou Bedrock (AWS)
SENTIMENT_PROVIDER=Ollama

# Ollama (local)
OLLAMA_MODEL=llama3.2

# Bedrock (AWS)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
